## 5) Frontend change — checkbox to select reimburseInETH (`frontend/src/SignIntent.jsx`)

Replace the SignIntent component with this updated version which shows a checkbox and includes the `reimburseInETH` flag in the signed intent and the data sent to the relayer.

```jsx
import React, { useState } from 'react'
import { ethers } from 'ethers'
import { sendIntentToRelayer } from './relayerClient'

export default function SignIntent() {
  const [status, setStatus] = useState('')
  const [asset, setAsset] = useState('0x0000000000000000000000000000000000000000')
  const [amount, setAmount] = useState('0')
  const [userTarget, setUserTarget] = useState('0x0000000000000000000000000000000000000000')
  const [reimburseInETH, setReimburseInETH] = useState(false)

  async function onSign() {
    try {
      if (!window.ethereum) throw new Error('No wallet');
      await window.ethereum.request({ method: 'eth_requestAccounts' });
      const provider = new ethers.BrowserProvider(window.ethereum);
      const signer = await provider.getSigner();
      const address = await signer.getAddress();

      const chainId = 1337;
      const intent = {
        chainId,
        asset,
        amount: amount.toString(),
        userTarget,
        userCallDataHex: '0x',
        nonce: Math.floor(Date.now() / 1000),
        ttl: Math.floor(Date.now() / 1000) + 600,
        estimatedGas: '300000',
        reimburseInETH
      }

      const domain = {
        name: 'FlashLoanGasSponsor',
        version: '1',
        chainId: intent.chainId,
        verifyingContract: (import.meta.env.VITE_ROUTER_ADDRESS || '')
      }

      const types = {
        Intent: [
          { name: 'chainId', type: 'uint256' },
          { name: 'asset', type: 'address' },
          { name: 'amount', type: 'uint256' },
          { name: 'userTarget', type: 'address' },
          { name: 'userCallDataHex', type: 'bytes' },
          { name: 'nonce', type: 'uint256' },
          { name: 'ttl', type: 'uint256' },
          { name: 'estimatedGas', type: 'uint256' },
          { name: 'reimburseInETH', type: 'bool' }
        ]
      }

      let signature;
      if (signer._signTypedData) {
        signature = await signer._signTypedData(domain, types, intent);
      } else {
        const payload = JSON.stringify({ domain, message: intent, primaryType: 'Intent', types: Object.assign({ EIP712Domain: [
          { name: 'name', type: 'string' },
          { name: 'version', type: 'string' },
          { name: 'chainId', type: 'uint256' },
          { name: 'verifyingContract', type: 'address' }
        ] }, types) });
        signature = await provider.send('eth_signTypedData_v4', [address, payload]);
      }

      setStatus('sending to relayer...');
      const res = await sendIntentToRelayer({ intent, signature, signerAddress: address });
      setStatus('submitted: ' + JSON.stringify(res));
    } catch (e) {
      setStatus('error: ' + e.message);
    }
  }

  return (
    <div>
      <div style={{ marginBottom: 8 }}>
        <label>Asset (token) address: <input value={asset} onChange={(e)=>setAsset(e.target.value)} style={{ width: 520 }} /></label>
      </div>
      <div style={{ marginBottom: 8 }}>
        <label>Amount (wei): <input value={amount} onChange={(e)=>setAmount(e.target.value)} style={{ width: 200 }} /></label>
      </div>
      <div style={{ marginBottom: 8 }}>
        <label>User target: <input value={userTarget} onChange={(e)=>setUserTarget(e.target.value)} style={{ width: 520 }} /></label>
      </div>
      <div style={{ marginBottom: 8 }}>
        <label><input type="checkbox" checked={reimburseInETH} onChange={(e)=>setReimburseInETH(e.target.checked)} /> Reimburse relayer in native ETH (unwrap WETH)</label>
      </div>
      <button onClick={onSign}>Sign & submit intent (EIP-712)</button>
      <div style={{ marginTop: 12 }}><strong>Status:</strong> {status}</div>
    </div>
  )
}
```

**Important:** When user selects `Reimburse in ETH`, the relayer will instruct the contract to unwrap WETH and send ETH to the relayer inside the flash loan callback. Ensure the `asset` provided is the WETH contract address on the chain used in testing.

